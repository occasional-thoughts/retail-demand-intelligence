            <column-instance column="[recommended_order_units]" derivation="Sum" name="[sum:recommended_order_units:qk]" pivot="key" type="quantitative" />
            <column caption="Stock Status" datatype="string" name="[stock_status]" role="dimension" type="nominal" />
            <column-instance column="[stock_status]" derivation="None" name="[none:stock_status:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style />
