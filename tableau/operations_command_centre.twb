  <dashboards>
    <dashboard name="Operations Command Centre">
      <style />
      <size maxheight="900" maxwidth="1600" minheight="900" minwidth="1600" />
      <zones>
        <zone h="100000" id="1" type-v2="layout-basic" w="100000" x="0" y="0">
          <zone h="6000" id="2" w="100000" x="0" y="0" type-v2="text">
            <formatted-text>
              <run>INVENTORY OPERATIONS COMMAND CENTRE - action required this week</run>
            </formatted-text>
          </zone>
          <zone h="44000" id="3" w="50000" x="0" y="6000" name="Action Queue" />
          <zone h="44000" id="4" w="50000" x="0" y="50000" name="Days To Stockout" />
          <zone h="44000" id="5" w="50000" x="50000" y="6000" name="Cover vs Lead Time" />
          <zone h="38000" id="6" w="50000" x="50000" y="50000" name="Projected Shortfall" />
          <zone h="6000" id="7" w="50000" x="50000" y="88000" type-v2="text">
            <formatted-text>
              <run>Stock positions are simulated from a documented policy (6 weeks opening cover, 95% service level). Forecast demand and supplier lead times are derived from actual order and delivery data.</run>
            </formatted-text>
          </zone>
        </zone>
      </zones>
    </dashboard>
  </dashboards>
  <windows source-height="30">
    <window class="worksheet" name="Action Queue" />
    <window class="worksheet" name="Days To Stockout" />
    <window class="worksheet" name="Cover vs Lead Time" />
    <window class="worksheet" name="Projected Shortfall" />
    <window class="worksheet" name="Supplier Lane Risk" />
    <window class="dashboard" maximized="true" name="Operations Command Centre">
      <viewpoints />
    </window>
  </windows>
</workbook>