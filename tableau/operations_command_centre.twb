              <groupfilter function="member" level="[federated.46ae42d0309d].[none:risk_flag:nk]" member="&quot;HIGH&quot;" />
              <groupfilter function="member" level="[federated.46ae42d0309d].[none:risk_flag:nk]" member="&quot;MEDIUM&quot;" />
